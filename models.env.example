# =============================================================================
# omp-mc Configuration
# Edit this file, then run ./install.sh to apply.
# =============================================================================

# -----------------------------------------------------------------------------
# [1] Model Assignments
# -----------------------------------------------------------------------------
# Available provider examples:
#   openai-codex/gpt-5.5:low      ... Codex low thinking (OpenCode subscription)
#   openai-codex/gpt-5.5:high     ... Codex high thinking
#   opencode-go/deepseek-v4-pro   ... DeepSeek V4 Pro (fast, low cost)
#   opencode-go/kimi-k2           ... Kimi K2
#   opencode-go/qwen-3-235b       ... Qwen3 235B

# Auditor / Thinker (design, spec analysis, code review)
export PI_SLOW_MODEL="openai-codex/gpt-5.5:low"

# Architect (architecture design, task planning)
export PI_PLAN_MODEL="openai-codex/gpt-5.5:low"

# Worker (coding, test creation, audit loop)
export PI_SMOL_MODEL="opencode-go/deepseek-v4-pro"

# (Optional) OpenCode Go auth key
export OPENCODE_API_KEY="${OPENCODE_API_KEY:-}"

# -----------------------------------------------------------------------------
# [2] Remote Access (omp-remote)
# -----------------------------------------------------------------------------
# REMOTE_MODE: "tailscale" (default) | "lan" | "disabled"
#   tailscale ... HTTPS via Tailscale Serve (PWA + push notifications)
#   lan       ... same LAN only (no Tailscale required)
#   disabled  ... do not use remote-agent
export REMOTE_MODE="tailscale"

# Remote access port
export REMOTE_PORT="44444"

# (tailscale mode) Enable Tailscale Funnel (public internet access)
# true exposes the server outside your tailnet. Use with caution.
export REMOTE_TAILSCALE_FUNNEL="false"
