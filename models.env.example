# =============================================================================
# omp-mc Configuration
# =============================================================================

# 🧠 最上位レイヤー: 監査役・最終判断 (OpenAI Codex)
# 思考が必要な設計の最終確認や、難解なバグの解決に使用
export PI_SLOW_MODEL="openai-codex/gpt-5.5:low"

# 📐 中間レイヤー: 設計・プランニング (OpenCode Go - Kimi)
# タスクの分解、ステップバイステップの計画立案に使用
export PI_PLAN_MODEL="opencode-go/kimi-k2.6"

# ⚡ 実行レイヤー: 実装・監査ループ消化 (OpenCode Go - DeepSeek Flash)
# 実際のコーディング、テスト作成、npm run audit の無限リトライに使用
export PI_SMOL_MODEL="opencode-go/deepseek-v4-flash"

# 🔑 OpenCode Go API Key (OAuthを使わない場合に推奨)
export OPENCODE_API_KEY="${OPENCODE_API_KEY:-}"

# -----------------------------------------------------------------------------
# Remote Access (omp-mc-remote)
# -----------------------------------------------------------------------------
export REMOTE_MODE="tailscale"
export REMOTE_PORT="44444"
export REMOTE_TAILSCALE_FUNNEL="false"
